<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>浮窗工坊</string>
			<key>footerText</key><string>右边缘滑出应用面板，点 App 开进浮窗；拖标题栏移动，拖右下角缩放，拖到屏幕边缘吸附 50/50 分屏。改动需 respring 生效。</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>label</key><string>启用</string>
			<key>key</key><string>enabled</string>
			<key>defaults</key><string>com.axs.appfloat</string>
			<key>default</key><true/>
		</dict>
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>浮窗应用</string>
			<key>footerText</key><string>选择哪些 App 出现在浮窗面板里；不选 = 全部显示。</string>
		</dict>
		<dict>
			<key>cell</key><string>PSLinkCell</string>
			<key>label</key><string>选择浮窗应用…</string>
			<key>detail</key><string>AxsAppFloatAppListController</string>
			<key>isController</key><true/>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>label</key><string>贴边吸附分屏</string>
			<key>key</key><string>snap_on</string>
			<key>defaults</key><string>com.axs.appfloat</string>
			<key>default</key><true/>
		</dict>
		<dict>
			<key>cell</key><string>PSSliderCell</string>
			<key>label</key><string>浮窗透明度</string>
			<key>key</key><string>window_alpha</string>
			<key>defaults</key><string>com.axs.appfloat</string>
			<key>default</key><real>1.0</real>
			<key>min</key><real>0.5</real>
			<key>max</key><real>1.0</real>
		</dict>
		<dict>
			<key>cell</key><string>PSSegmentCell</string>
			<key>label</key><string>最大浮窗</string>
			<key>key</key><string>max_windows</string>
			<key>defaults</key><string>com.axs.appfloat</string>
			<key>default</key><integer>2</integer>
			<key>validValues</key>
			<array>
				<integer>1</integer>
				<integer>2</integer>
			</array>
			<key>validTitles</key>
			<array>
				<string>1</string>
				<string>2</string>
			</array>
		</dict>
	</array>
	<key>title</key><string>浮窗工坊</string>
</dict>
</plist>
